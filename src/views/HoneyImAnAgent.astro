const features = t.features.map((f, i) => ({ ...f, icon: featureIcons[i] }));

const jsonLdGame = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Honey, I\'m an Agent',
  url: `${SITE}${localizePath('/games/Honey_Im_an_Agent/', lang)}`,
  sameAs: ['https://store.steampowered.com/app/4826960/Honey_Im_an_Agent/'],
  inLanguage: ['es', 'en'],
  description: t.ldDesc,
  genre: ['Action', 'Adventure', 'Indie'],
  gamePlatform: 'PC',
  applicationCategory: 'Game',
  author: { '@type': 'Organization', name: 'Multinow' },
  publisher: { '@type': 'Organization', name: 'Multinow' },
